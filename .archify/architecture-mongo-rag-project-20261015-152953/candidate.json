  "cards": [
    {
      "dot": "cyan",
      "title": "Query behavior",
      "items": [
        "Eligible list/count questions use a validated plan and query source MongoDB directly.",
        "Other questions use hybrid retrieval, optional relationship expansion, then bounded-context generation.",
        "The field catalog is persisted at vector_store/catalog.json and refreshed during ingestion."
      ]
    },
    {
      "dot": "emerald",
      "title": "Index behavior",
      "items": [
        "MongoDB embeddings are canonical; FAISS is a rebuildable local search index.",
        "Incremental ingestion skips unchanged chunks and removes stale records after a complete read.",
        "The API starts authorized ingestion as a background job; the management command runs it directly."
      ]
    }
  ]
